# GAINZALGO PRO MAX — environment configuration template.
#
# Copy this file to `.env` and adjust as needed for local development.
# NEVER commit a real `.env` file with real secrets or credentials.
#
# Every variable used anywhere in docker-compose.yml or the backend's
# app/core/config.py is listed here, per PROJECT_CONTRACT.md section 8.

# --- Core application ---------------------------------------------------
APP_ENV=development
APP_SECRET=dev-insecure-secret-change-me
LOG_LEVEL=INFO

# When true, the platform is expected to run entirely on mock market
# data and paper trading, with no external credentials required. This
# is the only mode Phase 1 through several later phases actually
# support; it exists now so every later phase reads the same setting.
DEMO_MODE=true

# --- Database / cache -----------------------------------------------
# Used directly by docker-compose to configure the postgres container.
POSTGRES_USER=gainzalgo
POSTGRES_PASSWORD=gainzalgo
POSTGRES_DB=gainzalgo

# Used by the backend to connect. The docker-compose default points at
# the "postgres"/"redis" service hostnames on the compose network; if
# running the backend outside Docker, point these at localhost instead.
DATABASE_URL=postgresql+asyncpg://gainzalgo:gainzalgo@postgres:5432/gainzalgo
REDIS_URL=redis://redis:6379/0

# --- Auth --------------------------------------------------------------
JWT_SECRET=dev-insecure-jwt-secret-change-me

# --- Trading safety defaults ------------------------------------------
# TRADING_MODE must remain PAPER for all phases up through the paper
# trading engine (see docs/development-roadmap.md, Phase 11). Changing
# this alone does NOT enable live trading — see PROJECT_CONTRACT.md
# section 9 for the full set of conditions required, most of which
# don't exist as code yet.
TRADING_MODE=PAPER
LIVE_MODE_ENABLED=false
PAPER_CAPITAL=100000
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=3.0
MAX_TRADES_PER_DAY=5

# --- Broker (Zerodha) — OPTIONAL. The app runs fully without these, ---
# --- falling back to mock/paper providers.                            -
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# --- Market data (Phase 3) -----------------------------------------
# How often (seconds) the mock provider generates a new batch of
# simulated ticks. Lower = more responsive demo, higher CPU/log volume.
MARKET_DATA_TICK_INTERVAL_SECONDS=1.0
# Closed candles of simulated history generated at startup, so indicators
# (200 MA, ATR baseline, session VWAP) have data immediately. This many
# 60m candles are built from one 5m path (shared by 5m/15m/30m/60m);
# 1m and 3m get this many candles each. 0 = none.
MARKET_DATA_WARMUP_CANDLES=250
# Seconds between chances for each simulated symbol to switch behaviour
# (trending / range / breakout / high volatility). 0 disables rotation.
MARKET_DATA_REGIME_ROTATION_SECONDS=900

# --- Market intelligence (Phase 4) -----------------------------------
# Timeframe the engines and regime detector analyse (closed candles only).
INTELLIGENCE_TIMEFRAME=5m
# How often (seconds) every watchlist symbol is re-analysed.
INTELLIGENCE_REFRESH_SECONDS=5.0

# --- Price action (Phase 5) -------------------------------------------
# Multi-timeframe roles: context > setup > entry (1m/3m/5m/15m/30m/60m).
PRICE_ACTION_CONTEXT_TIMEFRAME=60m
PRICE_ACTION_SETUP_TIMEFRAME=15m
PRICE_ACTION_ENTRY_TIMEFRAME=5m
# How often (seconds) every watchlist symbol is re-analysed.
PRICE_ACTION_REFRESH_SECONDS=15.0

# --- Signals and scanner (Phase 7) ------------------------------------
# Score (0-100) at or above which a signal is READY. Not a profit claim.
SIGNAL_EXECUTABLE_THRESHOLD=85
# Candidates below this score are shown by the scanner but not stored.
SIGNAL_STORE_MIN_SCORE=70
# How many ranked candidates the scanner returns as "top".
SCANNER_TOP_N=10
# Optional JSON overriding scoring weights (unlisted keep their defaults).
# Defaults are the brief's initial model and are not assumed optimal:
# SIGNAL_SCORE_WEIGHTS={"market_alignment":15,"relative_strength":15,"trend_quality":15,"vwap":10,"market_structure":10,"retracement":10,"volume":10,"momentum":5,"price_action":5}

# --- Risk engine (Phase 8) -------------------------------------------
# PAPER_CAPITAL, RISK_PER_TRADE (%), MAX_DAILY_LOSS (%) and
# MAX_TRADES_PER_DAY above are also risk limits. These complete the set.
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_POSITION_VALUE=50000
RISK_MAX_EXPOSURE=50000
RISK_LOT_SIZE=1
RISK_TICK_SIZE=0.05
RISK_MAX_ORDER_QUANTITY=100000
# 1.0 = no leverage (the conservative paper default).
RISK_MARGIN_MULTIPLIER=1.0
RISK_MAX_DATA_AGE_SECONDS=30
RISK_MAX_SIGNAL_AGE_SECONDS=120
# Reject when price has moved this fraction of the stop distance against the entry.
RISK_MAX_ENTRY_DEVIATION_R=0.25
RISK_ALLOW_SHORT=true
# EXCHANGE: NSE hours (IST, Mon-Fri). SIMULATED_24H: always in-session,
# for exercising the simulated feed outside exchange hours.
TRADING_SESSION_MODE=EXCHANGE
TRADING_LAST_ENTRY_TIME=15:00
TRADING_SQUARE_OFF_TIME=15:15
# Exchange holidays as a JSON list; none are built in.
# TRADING_HOLIDAYS=["2026-10-02"]

# --- Paper broker (Phase 8) -------------------------------------------
# Execution assumptions. Paper results depend on them; they are not live fills.
PAPER_SLIPPAGE_BPS=5
PAPER_EXECUTION_DELAY_SECONDS=0
# Below 1.0, each price update fills at most this fraction of an order.
PAPER_MAX_FILL_FRACTION=1.0
PAPER_ENTRY_TIMEOUT_SECONDS=60
# Whether an emergency stop also closes an open position when the
# request does not say. Off: positions are never auto-closed.
PAPER_EMERGENCY_CLOSE_POSITIONS=false
# Optional JSON overriding cost-model fields (verify against your broker):
# PAPER_COSTS={"brokerage_rate":0.0003,"brokerage_cap_per_order":20,"stt_sell_rate":0.00025,"exchange_rate":0.0000297,"sebi_per_crore":10,"stamp_buy_rate":0.00003,"gst_rate":0.18}

# --- Frontend -----------------------------------------------------------
# Browser-facing URL used by the frontend to call the backend. Must
# stay reachable from the developer's own browser, not just from other
# containers — that's why it says "localhost", not "backend".
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
